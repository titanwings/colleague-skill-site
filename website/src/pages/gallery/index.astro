---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillGallery from '../../components/SkillGallery.astro';
import { getAllSkills } from '../../lib/skills';

const base = import.meta.env.BASE_URL;
const skills = await getAllSkills();

const metaSkillCount = skills.filter((s) => s.type === 'meta-skill').length;
const contributorCount = new Set(skills.map((s) => s.author.github)).size;

const stats = [
  { value: skills.length, labelZh: '已收录 Skill', labelEn: 'Skills listed' },
  { value: metaSkillCount, labelZh: 'meta-skill', labelEn: 'meta-skills' },
  { value: contributorCount, labelZh: '社区贡献者', labelEn: 'Contributors' },
];

const submitUrl = 'https://github.com/titanwings/colleague-skill-site/issues/new?template=submit-skill.yml';
const templateUrl =
  'https://github.com/titanwings/colleague-skill-site/blob/main/website/src/content/skills/_template.yaml';
---

<BaseLayout
  title="Skill Gallery — dot-skill"
  description={`浏览 ${skills.length} 个社区贡献的 dot-skill：安全、前端、数据、HR、管理……找到你需要的，随时召唤。`}
>
  <div class="lang-scope mx-auto max-w-7xl px-4 pb-24 pt-28 sm:px-6 lg:px-8">
    <!-- Page header -->
    <header class="reveal max-w-3xl">
      <p class="section-label">Marketplace · 技能市场</p>
      <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Skill Gallery
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft">
        <span class="lang-zh">
          社区贡献的 dot-skill 目录。他们离开了，但智慧还在——搜索、筛选，然后把任何一个装进你的
          coding agent。
        </span>
        <span class="lang-en">
          A catalog of community-distilled Skills. They left. The Skills stayed. Search, filter, then
          install one into your coding agent.
        </span>
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <!-- `text-plate` overrides `.btn-primary`'s hard-coded `text-white`, which
             fails AA on the accent fill (4.05:1 light / 2.26:1 dark). Swap for
             `text-accent-ink` once that token exists and global.css is fixed. -->
        <a
          href={submitUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary justify-center text-plate"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span class="lang-zh">提交我的 Skill</span>
          <span class="lang-en">Submit my Skill</span>
        </a>
        <a href={templateUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary justify-center">
          <span class="lang-zh">查看提交模板</span>
          <span class="lang-en">View the template</span>
        </a>
      </div>
    </header>

    <!-- Catalog stats: hairline-divided cells, no cards, no glow -->
    <dl class="reveal mt-14 grid grid-cols-1 gap-px border-y border-line bg-line sm:grid-cols-3">
      {stats.map((stat) => (
        <div class="bg-paper px-5 py-6">
          <dt class="font-grotesk text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted">
            <span class="lang-zh">{stat.labelZh}</span>
            <span class="lang-en">{stat.labelEn}</span>
          </dt>
          <dd class="mt-2 font-display text-3xl font-semibold text-ink">{stat.value}</dd>
        </div>
      ))}
    </dl>

    <!-- Catalog -->
    <div class="reveal mt-14">
      <SkillGallery skills={skills} base={base} />
    </div>
  </div>
</BaseLayout>
