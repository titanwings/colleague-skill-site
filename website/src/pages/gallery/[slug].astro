---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillCard from '../../components/SkillCard.astro';
import { getAllSkills } from '../../lib/skills';
import { AGENTS, cloneCommand, skillsCliCommand, skillsCliSupported } from '../../data/agents';
import type { SkillMeta } from '../../types/skill';

export async function getStaticPaths() {
  const skills = await getAllSkills();
  return skills.map((skill) => ({
    params: { slug: skill.slug },
    props: { skill },
  }));
}

interface Props {
  skill: SkillMeta;
}

const { skill } = Astro.props;
const base = import.meta.env.BASE_URL;
const allSkills = await getAllSkills();

/**
 * `preview_conversation` is present in 97 of the 215 YAML files (and in
 * `_template.yaml`) but is missing from `SkillMeta`, so it is read through a
 * local widening rather than editing the shared type.
 */
interface PreviewTurn {
  role?: string;
  content?: string;
}
const withPreview = skill as SkillMeta & { preview_conversation?: PreviewTurn[] };
const preview = Array.isArray(withPreview.preview_conversation)
  ? withPreview.preview_conversation.filter((turn) => Boolean(turn?.content))
  : [];

const skillType = skill.type === 'meta-skill' ? 'meta-skill' : 'skill';

const cultureMap: Record<string, string> = {
  '字节风': 'ByteDance',
  '阿里风': 'Alibaba',
  '腾讯风': 'Tencent',
  '华为风': 'Huawei',
  '创业风': 'Startup',
  '外企风': 'MNC',
  '国企风': 'SOE',
  '其他': 'Other',
};

const personalityMap: Record<string, string> = {
  '严谨': 'Rigorous',
  '直接': 'Direct',
  '完美主义': 'Perfectionist',
  '务实': 'Pragmatic',
  '细心': 'Meticulous',
  '坦诚': 'Candid',
  '经验丰富': 'Seasoned',
  '不废话': 'No BS',
  '现实主义': 'Realist',
  '黑色幽默': 'Dark Humor',
  '直击要害': 'Straight Shooter',
  '去魅思维': 'Demystifier',
  '直接压迫': 'Bluntly Direct',
  '人文关怀': 'Humanist',
  '理性克制': 'Rational',
  '举例达人': 'Example Pro',
};

function formatStars(n: number): string {
  if (n < 1000) return String(n);
  if (n < 10000) {
    // NB: a `/\\.0$/`-style regex literal here breaks Astro's export hoisting —
    // keep this as string surgery.
    const rounded = (n / 1000).toFixed(1);
    return (rounded.endsWith('.0') ? rounded.slice(0, -2) : rounded) + 'k';
  }
  return Math.round(n / 1000) + 'k';
}

const stars = typeof skill.stars === 'number' ? skill.stars : null;
const starsSyncedAt = skill.stars_synced_at ? skill.stars_synced_at.slice(0, 10) : null;
const updatedAt = starsSyncedAt ?? skill.created_at;

/** Exact install routes for the *creator* Skill, straight from data/agents.ts. */
/**
 * Exact install routes for the *creator* Skill, straight from data/agents.ts.
 *
 * `skillsCliSupported()` gates the AgentSkills CLI route: Pi has a documented
 * install directory but no confirmed `--agent` id, so it gets the direct-clone
 * command (also from agents.ts) plus an explicit "unconfirmed" flag instead of a
 * command we cannot stand behind.
 */
const agents = AGENTS.map((agent, index) => {
  const cliSupported = skillsCliSupported(agent.id);
  return {
    id: agent.id,
    label: agent.label,
    capability: agent.capability,
    globalPath: agent.globalPath,
    projectPath: agent.projectPath,
    note: agent.note,
    cliSupported,
    globalCommand: cliSupported ? skillsCliCommand(agent.id, 'global', { requireVerified: true }) : null,
    projectCommand:
      cliSupported && agent.projectPath ? skillsCliCommand(agent.id, 'project', { requireVerified: true }) : null,
    cloneCommand: cloneCommand(agent.id, 'global'),
    isFirst: index === 0,
  };
});

/**
 * Related = shares at least one tag. A shared *specific* tag outranks the
 * catch-all `other`, which 186 of 215 Skills carry, so the list stays useful.
 */
const ownTags = new Set(skill.tags ?? []);
const related = allSkills
  .filter((other) => other.slug !== skill.slug)
  .map((other) => {
    const shared = (other.tags ?? []).filter((tag) => ownTags.has(tag));
    return { other, sharedCount: shared.length, specificCount: shared.filter((tag) => tag !== 'other').length };
  })
  .filter((entry) => entry.sharedCount > 0)
  .sort(
    (a, b) =>
      b.specificCount - a.specificCount ||
      b.sharedCount - a.sharedCount ||
      Number(Boolean(b.other.pinned)) - Number(Boolean(a.other.pinned)) ||
      (b.other.stars ?? 0) - (a.other.stars ?? 0)
  )
  .slice(0, 4)
  .map((entry) => entry.other);

const metaLabel = 'font-grotesk text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted';
const metaValue = 'mt-1.5 text-sm text-ink';
---

<BaseLayout title={`${skill.name} — dot-skill Gallery`} description={skill.description} ogType="profile">
  <article class="mx-auto max-w-5xl px-4 pb-24 pt-28 sm:px-6 lg:px-8">
    <!-- Back -->
    <a
      href={`${base}/gallery/`}
      class="inline-flex items-center gap-2 font-mono text-sm text-ink-muted no-underline transition-colors hover:text-accent-soft hover:no-underline"
    >
      <span aria-hidden="true">←</span>
      <span class="lang-zh">返回 Gallery</span>
      <span class="lang-en">Back to Gallery</span>
    </a>

    <!-- ------------------------------------------------------------ header -->
    <header class="mt-8">
      <p class={metaLabel}>
        <span class="text-accent-soft">{skillType}</span>
        {skill.company_culture && (
          <>
            <span class="mx-1.5 text-ink-dim" aria-hidden="true">/</span>
            <span>
              <span class="lang-zh">{skill.company_culture}</span>
              <span class="lang-en">{cultureMap[skill.company_culture] || skill.company_culture}</span>
            </span>
          </>
        )}
      </p>

      <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        {skill.name}
      </h1>

      <p class="mt-3 font-mono text-sm text-ink-muted">
        <span class="lang-zh">{skill.level || '社区贡献 Skill'}</span>
        <span class="lang-en">{skill.level_en || skill.level || 'Community Skill'}</span>
      </p>

      <div class="mt-6 max-w-[68ch] space-y-3">
        <p class="text-lg leading-8 text-ink">
          <span class="lang-zh">{skill.description}</span>
          <span class="lang-en">{skill.description_en || skill.description}</span>
        </p>
      </div>

      <p class="mt-4 text-sm text-ink-muted">
        <span class="lang-zh">贡献者</span>
        <span class="lang-en">Contributed by</span>
        <a
          href={`https://github.com/${skill.author.github}`}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1.5 font-mono text-accent-soft"
        >
          {skill.author.name} (@{skill.author.github})
        </a>
      </p>

      <!-- Meta strip -->
      <dl class="mt-10 grid grid-cols-2 gap-px border-y border-line bg-line sm:grid-cols-3 lg:grid-cols-5">
        <div class="bg-paper px-4 py-4">
          <dt class={metaLabel}>
            <span class="lang-zh">类型</span>
            <span class="lang-en">Type</span>
          </dt>
          <dd class={`${metaValue} font-mono`}>{skillType}</dd>
        </div>

        <div class="bg-paper px-4 py-4">
          <dt class={metaLabel}>
            <span class="lang-zh">标签</span>
            <span class="lang-en">Tags</span>
          </dt>
          <dd class="mt-1.5 flex flex-wrap gap-1.5">
            {(skill.tags ?? []).map((tag) => (
              <span class="rounded-pill border border-line bg-paper-sunk px-2 py-0.5 font-mono text-[11px] text-ink-muted">
                {tag}
              </span>
            ))}
          </dd>
        </div>

        <div class="bg-paper px-4 py-4">
          <dt class={metaLabel}>Stars</dt>
          <dd class={metaValue}>
            {stars === null ? (
              <span class="font-mono text-ink-muted">—</span>
            ) : (
              <span class="font-mono">{formatStars(stars)}</span>
            )}
            {starsSyncedAt && <span class="mt-1 block font-mono text-[11px] text-ink-muted">{starsSyncedAt}</span>}
          </dd>
        </div>

        <div class="bg-paper px-4 py-4">
          <dt class={metaLabel}>
            <span class="lang-zh">更新</span>
            <span class="lang-en">Updated</span>
          </dt>
          <dd class={metaValue}>
            <span class="font-mono">{updatedAt}</span>
            <span class="mt-1 block font-mono text-[11px] text-ink-muted">
              {starsSyncedAt ? (
                <>
                  <span class="lang-zh">stars 同步</span>
                  <span class="lang-en">stars synced</span>
                </>
              ) : (
                <>
                  <span class="lang-zh">收录时间</span>
                  <span class="lang-en">listed</span>
                </>
              )}
            </span>
          </dd>
        </div>

        <div class="bg-paper px-4 py-4">
          <dt class={metaLabel}>
            <span class="lang-zh">仓库</span>
            <span class="lang-en">Repository</span>
          </dt>
          <dd class={metaValue}>
            {skill.skill_repo ? (
              <a
                href={skill.skill_repo}
                target="_blank"
                rel="noopener noreferrer"
                class="break-all font-mono text-xs text-accent-soft"
              >
                {skill.skill_repo.replace(/^https?:\/\/(www\.)?github\.com\//, '').replace(/\/$/, '')}
              </a>
            ) : (
              <span class="font-mono text-xs text-ink-muted">
                <span class="lang-zh">未提供</span>
                <span class="lang-en">not provided</span>
              </span>
            )}
          </dd>
        </div>
      </dl>
    </header>

    <!-- ----------------------------------------------------------- install -->
    <section id="install" class="mt-16" aria-labelledby="install-heading">
      <h2 id="install-heading" class="font-display text-3xl font-semibold tracking-tight text-ink">
        <span class="lang-zh">安装</span>
        <span class="lang-en">Install</span>
      </h2>
      <p class="mt-3 max-w-[68ch] text-[15px] leading-7 text-ink-soft">
        <span class="lang-zh">
          目录数据里没有「某个 Skill 的安装命令」这个字段，所以我们不猜命令：第 01 步给出作者仓库，第
          02 步给出 creator Skill（distilly）在每个 coding agent 里的确切安装方式。
        </span>
        <span class="lang-en">
          The catalog has no per-Skill install-command field, so nothing is guessed here: step 01
          links the author's repository, step 02 gives the exact install route for the creator Skill
          (distilly) on every supported coding agent.
        </span>
      </p>

      <ol class="mt-8 space-y-10">
        <!-- Step 01 — the Skill itself -->
        <li>
          <div class="flex items-baseline gap-4">
            <span class="font-mono text-sm text-ink-muted" aria-hidden="true">01</span>
            <h3 class="font-display text-xl font-semibold text-ink">
              <span class="lang-zh">拿到这个 Skill</span>
              <span class="lang-en">Get this Skill</span>
            </h3>
          </div>
          <div class="mt-3 pl-0 sm:pl-9">
            {skill.skill_repo ? (
              <div class="rounded-card border border-line bg-paper-raised p-5">
                <p class={metaLabel}>
                  <span class="lang-zh">作者仓库</span>
                  <span class="lang-en">Author repository</span>
                </p>
                <a
                  href={skill.skill_repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 inline-block break-all font-mono text-sm text-accent-soft"
                >
                  {skill.skill_repo}
                </a>
                <p class="mt-3 max-w-[68ch] text-sm leading-7 text-ink-muted">
                  <span class="lang-zh">
                    文件名、目录结构与加载方式以该仓库为准。本目录不提供（也不猜测）这个 Skill
                    的安装命令。
                  </span>
                  <span class="lang-en">
                    File names, layout and loading steps are whatever that repository says. This
                    catalog does not provide — or guess — an install command for this Skill.
                  </span>
                </p>
              </div>
            ) : (
              <p class="max-w-[68ch] text-sm leading-7 text-ink-muted">
                <span class="lang-zh">这条记录没有提供作者仓库链接，无法进一步核实。</span>
                <span class="lang-en">This record has no repository link, so nothing further can be verified.</span>
              </p>
            )}
          </div>
        </li>

        <!-- Step 02 — the creator Skill -->
        <li>
          <div class="flex items-baseline gap-4">
            <span class="font-mono text-sm text-ink-muted" aria-hidden="true">02</span>
            <h3 class="font-display text-xl font-semibold text-ink">
              <span class="lang-zh">安装 creator Skill（distilly）</span>
              <span class="lang-en">Install the creator Skill (distilly)</span>
            </h3>
          </div>

          <div class="mt-3 pl-0 sm:pl-9">
            <p class="max-w-[68ch] text-sm leading-7 text-ink-muted">
              <span class="lang-zh">
                这一步装的是蒸馏工具本身，不是上面那个 Skill。命令与目录来自仓库里的
                <code class="font-mono text-xs text-ink">data/agents.ts</code>，未做任何猜测。
              </span>
              <span class="lang-en">
                This installs the distillery itself, not the Skill above. Commands and paths come
                from <code class="font-mono text-xs text-ink">data/agents.ts</code> — nothing here is
                guessed.
              </span>
            </p>

            <div id="install-agents" class="mt-5">
              <div
                role="tablist"
                aria-label="Coding agents"
                class="flex flex-wrap gap-2 border-b border-line pb-4"
              >
                {agents.map((agent) => (
                  <button
                    type="button"
                    role="tab"
                    id={`agent-tab-${agent.id}`}
                    class="tab"
                    aria-selected={agent.isFirst ? 'true' : 'false'}
                    aria-controls={`agent-panel-${agent.id}`}
                    tabindex={agent.isFirst ? 0 : -1}
                    data-agent-tab={agent.id}
                  >
                    {agent.label}
                  </button>
                ))}
              </div>

              {agents.map((agent) => (
                <div
                  role="tabpanel"
                  id={`agent-panel-${agent.id}`}
                  aria-labelledby={`agent-tab-${agent.id}`}
                  tabindex="0"
                  hidden={!agent.isFirst}
                  class="pt-6"
                >
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="rounded-pill border border-line bg-paper-sunk px-2 py-0.5 font-mono text-[11px] text-ink-muted">
                      {agent.id}
                    </span>
                    <span class="flex items-center gap-1.5 font-mono text-[11px] text-ink-muted">
                      <span
                        class={`h-1.5 w-1.5 rounded-pill ${agent.capability === 'full' ? 'bg-ok' : 'bg-warn'}`}
                        aria-hidden="true"></span>
                      {agent.capability === 'full' ? (
                        <>
                          <span class="lang-zh">完整能力</span>
                          <span class="lang-en">full capability</span>
                        </>
                      ) : (
                        <>
                          <span class="lang-zh">仅提示词</span>
                          <span class="lang-en">prompt-only</span>
                        </>
                      )}
                    </span>
                    {!agent.cliSupported && (
                      <span class="flex items-center gap-1.5 font-mono text-[11px] text-warn">
                        <span class="h-1.5 w-1.5 rounded-pill bg-warn" aria-hidden="true"></span>
                        <span class="lang-zh">CLI 未确认</span>
                        <span class="lang-en">CLI unconfirmed</span>
                      </span>
                    )}
                  </div>

                  {agent.globalCommand ? (
                    <>
                      <!-- Global install (verified AgentSkills CLI target) -->
                      <p class={`${metaLabel} mt-6`}>
                        <span class="lang-zh">全局安装命令</span>
                        <span class="lang-en">Global install command</span>
                      </p>
                      <div class="mt-2 flex flex-wrap items-start gap-2">
                        <div class="code-block min-w-0 flex-1 p-3">
                          <pre class="overflow-x-auto text-xs leading-6 text-plate-ink"><code>{agent.globalCommand}</code></pre>
                        </div>
                        <button
                          type="button"
                          class="copy-cmd"
                          data-command={agent.globalCommand}
                          aria-label={`Copy the ${agent.label} install command`}
                        >
                          <span class="lang-zh">复制</span>
                          <span class="lang-en">Copy</span>
                        </button>
                        <span class="copy-status" role="status" aria-live="polite"></span>
                      </div>
                    </>
                  ) : (
                    <>
                      <!-- No confirmed `--agent` id: state that, and give the clone route -->
                      <p class="mt-6 max-w-[68ch] border-l-2 border-warn/50 pl-4 text-sm leading-7 text-ink-muted">
                        <span class="lang-zh">
                          AgentSkills CLI 还没有确认支持 {agent.label}（
                          <code class="font-mono text-xs">--agent {agent.id}</code> 未经验证），所以这里不给这条命令，改用下面的直接克隆。
                        </span>
                        <span class="lang-en">
                          The AgentSkills CLI is not a confirmed target for {agent.label} (
                          <code class="font-mono text-xs">--agent {agent.id}</code> is unverified), so that
                          command is not shown — use the direct clone below.
                        </span>
                      </p>
                      <p class={`${metaLabel} mt-6`}>
                        <span class="lang-zh">直接克隆命令</span>
                        <span class="lang-en">Direct clone command</span>
                      </p>
                      <div class="mt-2 flex flex-wrap items-start gap-2">
                        <div class="code-block min-w-0 flex-1 p-3">
                          <pre class="overflow-x-auto text-xs leading-6 text-plate-ink"><code>{agent.cloneCommand}</code></pre>
                        </div>
                        <button
                          type="button"
                          class="copy-cmd"
                          data-command={agent.cloneCommand}
                          aria-label={`Copy the ${agent.label} clone command`}
                        >
                          <span class="lang-zh">复制</span>
                          <span class="lang-en">Copy</span>
                        </button>
                        <span class="copy-status" role="status" aria-live="polite"></span>
                      </div>
                    </>
                  )}

                  <!-- Paths -->
                  <p class={`${metaLabel} mt-6`}>
                    <span class="lang-zh">安装目录</span>
                    <span class="lang-en">Install directory</span>
                  </p>
                  <dl class="mt-2 grid gap-px border border-line bg-line sm:grid-cols-2">
                    <div class="bg-paper-raised px-4 py-3">
                      <dt class="font-mono text-[11px] text-ink-muted">
                        <span class="lang-zh">全局</span>
                        <span class="lang-en">global</span>
                      </dt>
                      <dd class="mt-1 break-all font-mono text-xs text-ink">{agent.globalPath}</dd>
                    </div>
                    <div class="bg-paper-raised px-4 py-3">
                      <dt class="font-mono text-[11px] text-ink-muted">
                        <span class="lang-zh">项目级</span>
                        <span class="lang-en">project</span>
                      </dt>
                      <dd class="mt-1 break-all font-mono text-xs text-ink">
                        {agent.projectPath ?? (
                          <>
                            <span class="lang-zh">未文档化，使用全局安装</span>
                            <span class="lang-en">not documented — use the global install</span>
                          </>
                        )}
                      </dd>
                    </div>
                  </dl>

                  {agent.projectCommand && (
                    <>
                      <p class={`${metaLabel} mt-6`}>
                        <span class="lang-zh">项目级安装命令</span>
                        <span class="lang-en">Project-scoped command</span>
                      </p>
                      <div class="mt-2 flex flex-wrap items-start gap-2">
                        <div class="code-block min-w-0 flex-1 p-3">
                          <pre class="overflow-x-auto text-xs leading-6 text-plate-ink"><code>{agent.projectCommand}</code></pre>
                        </div>
                        <button
                          type="button"
                          class="copy-cmd"
                          data-command={agent.projectCommand}
                          aria-label={`Copy the project-scoped ${agent.label} install command`}
                        >
                          <span class="lang-zh">复制</span>
                          <span class="lang-en">Copy</span>
                        </button>
                        <span class="copy-status" role="status" aria-live="polite"></span>
                      </div>
                    </>
                  )}

                  <!-- Honest host note -->
                  <p
                    class="mt-6 max-w-[68ch] border-l-2 border-line pl-4 text-sm leading-7 text-ink-muted"
                  >
                    <span class="lang-zh">{agent.note.zh}</span>
                    <span class="lang-en">{agent.note.en}</span>
                  </p>
                </div>
              ))}
            </div>
          </div>
        </li>

        <!-- Step 03 — load it -->
        <li>
          <div class="flex items-baseline gap-4">
            <span class="font-mono text-sm text-ink-muted" aria-hidden="true">03</span>
            <h3 class="font-display text-xl font-semibold text-ink">
              <span class="lang-zh">让你的 agent 读到它</span>
              <span class="lang-en">Point your agent at it</span>
            </h3>
          </div>
          <p class="mt-3 max-w-[68ch] pl-0 text-sm leading-7 text-ink-muted sm:pl-9">
            <span class="lang-zh">
              把第 01 步仓库里的 Skill 文件放到你的 agent 能读到的位置；具体文件名与加载方式以作者仓库
              的说明为准。
            </span>
            <span class="lang-en">
              Put the Skill file from step 01 where your agent can read it; the exact file name and
              loading steps are whatever the author's repository documents.
            </span>
          </p>
        </li>
      </ol>
    </section>

    <!-- --------------------------------------------------- example exchange -->
    {preview.length > 0 && (
      <section class="mt-16" aria-labelledby="example-heading">
        <h2 id="example-heading" class="font-display text-3xl font-semibold tracking-tight text-ink">
          <span class="lang-zh">对话示例</span>
          <span class="lang-en">Example exchange</span>
        </h2>
        <p class="mt-3 max-w-[68ch] text-[15px] leading-7 text-ink-soft">
          <span class="lang-zh">作者提交的示例对话，展示这个 Skill 的语气与思路。</span>
          <span class="lang-en">A sample exchange submitted by the author, showing tone and reasoning.</span>
        </p>
        <ol class="mt-6 divide-y divide-line border-y border-line">
          {preview.map((turn) => (
            <li class="grid gap-1 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6">
              <p class={metaLabel}>
                {turn.role === 'user' ? (
                  <>
                    <span class="lang-zh">用户</span>
                    <span class="lang-en">User</span>
                  </>
                ) : (
                  <>
                    <span class="lang-zh">Skill</span>
                    <span class="lang-en">Skill</span>
                  </>
                )}
              </p>
              <p class="max-w-[68ch] text-[15px] leading-8 text-ink">
                <span class="lang-zh">{turn.content}</span>
                <span class="lang-en">{turn.content}</span>
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- -------------------------------------------------------------- source -->
    <section class="mt-16" aria-labelledby="source-heading">
      <h2 id="source-heading" class="font-display text-3xl font-semibold tracking-tight text-ink">
        <span class="lang-zh">来源与收录信息</span>
        <span class="lang-en">Source and catalog record</span>
      </h2>

      <div class="mt-6 grid gap-px border-y border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        <div class="bg-paper px-4 py-4">
          <p class={metaLabel}>
            <span class="lang-zh">贡献者</span>
            <span class="lang-en">Contributor</span>
          </p>
          <p class="mt-1.5 text-sm text-ink">{skill.author.name}</p>
          <a
            href={`https://github.com/${skill.author.github}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 inline-block font-mono text-xs text-accent-soft"
          >
            @{skill.author.github}
          </a>
        </div>

        <div class="bg-paper px-4 py-4">
          <p class={metaLabel}>
            <span class="lang-zh">收录时间</span>
            <span class="lang-en">Listed</span>
          </p>
          <p class="mt-1.5 font-mono text-sm text-ink">{skill.created_at}</p>
        </div>

        <div class="bg-paper px-4 py-4">
          <p class={metaLabel}>
            <span class="lang-zh">Stars 快照</span>
            <span class="lang-en">Stars snapshot</span>
          </p>
          <p class="mt-1.5 font-mono text-sm text-ink">
            {stars === null ? '—' : formatStars(stars)}
          </p>
          <p class="mt-1 font-mono text-[11px] text-ink-muted">{starsSyncedAt ?? '—'}</p>
        </div>

        <div class="bg-paper px-4 py-4">
          <p class={metaLabel}>
            <span class="lang-zh">源仓库</span>
            <span class="lang-en">Source repo</span>
          </p>
          {skill.skill_repo ? (
            <a
              href={skill.skill_repo}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1.5 inline-block break-all font-mono text-xs text-accent-soft"
            >
              {skill.skill_repo}
            </a>
          ) : (
            <p class="mt-1.5 font-mono text-xs text-ink-muted">
              <span class="lang-zh">未提供</span>
              <span class="lang-en">not provided</span>
            </p>
          )}
        </div>
      </div>

      {(skill.personality ?? []).length > 0 && (
        <>
          <p class={`${metaLabel} mt-8`}>
            <span class="lang-zh">性格标签</span>
            <span class="lang-en">Personality</span>
          </p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {(skill.personality ?? []).map((trait) => (
              <li class="rounded-pill border border-line bg-paper-sunk px-2.5 py-0.5 font-mono text-[11px] text-ink-muted">
                <span class="lang-zh">{trait}</span>
                <span class="lang-en">{personalityMap[trait] || trait}</span>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>

    <!-- ------------------------------------------------------------- related -->
    {related.length > 0 && (
      <section class="mt-16" aria-labelledby="related-heading">
        <h2 id="related-heading" class="font-display text-3xl font-semibold tracking-tight text-ink">
          <span class="lang-zh">相关 Skill</span>
          <span class="lang-en">Related Skills</span>
        </h2>
        <p class="mt-3 max-w-[68ch] text-[15px] leading-7 text-ink-soft">
          <span class="lang-zh">
            同标签的其它 Skill（优先展示共享具体标签、而非 <code class="font-mono text-xs">other</code> 的条目）。
          </span>
          <span class="lang-en">
            Others sharing a tag — entries sharing a specific tag outrank the catch-all
            <code class="font-mono text-xs">other</code>.
          </span>
        </p>
        <ul class={`mt-6 grid grid-cols-1 gap-4 ${related.length >= 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 lg:grid-cols-3'}`}>
          {related.map((item) => (
            <li>
              <SkillCard skill={item} base={base} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style is:global>
  /*
   * Agent tabs and copy buttons. Kept in a global block on purpose: every
   * selector is namespaced by `#install-agents`, so nothing leaks. Language
   * pairing is NOT handled here — `global.css` owns `.lang-zh` / `.lang-en`.
   */

  /* Agent tabs. Selection is driven by `aria-selected`, so the visual state and
     the accessible state can never drift apart. */
  #install-agents .tab {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border: 1px solid rgb(var(--line));
    border-radius: 999px;
    background: rgb(var(--paper-raised));
    color: rgb(var(--ink-muted));
    font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.5;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  #install-agents .tab:hover {
    border-color: rgb(var(--accent) / 0.45);
    color: rgb(var(--ink));
  }
  #install-agents .tab[aria-selected='true'] {
    border-color: rgb(var(--accent) / 0.6);
    background: rgb(var(--accent-wash));
    color: rgb(var(--ink));
  }
  /* Panels are toggled with the `hidden` attribute; declared explicitly so a
     future display utility on the panel cannot accidentally win. */
  #install-agents [role='tabpanel'][hidden] {
    display: none;
  }

  #install-agents .copy-cmd {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding: 0.375rem 0.625rem;
    border: 1px solid rgb(var(--line));
    border-radius: 8px;
    background: rgb(var(--paper-raised));
    color: rgb(var(--ink-muted));
    font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  #install-agents .copy-cmd:hover {
    border-color: rgb(var(--accent) / 0.45);
    color: rgb(var(--ink));
  }
  #install-agents .copy-cmd[data-copied='true'] {
    border-color: rgb(var(--accent) / 0.6);
    background: rgb(var(--accent-wash));
    color: rgb(var(--ink));
  }
  #install-agents .copy-status {
    color: rgb(var(--ink-muted));
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    line-height: 2;
  }
</style>

<script>
  const tablist = document.getElementById('install-agents');

  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(tablist.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    /** Show one agent panel and keep the roving tabindex in sync. */
    function selectAgentTab(active: HTMLButtonElement, moveFocus = false): void {
      for (const tab of tabs) {
        const selected = tab === active;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      }
      for (const panel of panels) {
        panel.hidden = panel.id !== active.getAttribute('aria-controls');
      }
      if (moveFocus) active.focus();
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => selectAgentTab(tab));
      tab.addEventListener('keydown', (event) => {
        const keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End'];
        if (!keys.includes(event.key)) return;
        event.preventDefault();
        const index = tabs.indexOf(tab);
        const next =
          event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? tabs.length - 1
              : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        selectAgentTab(tabs[next], true);
      });
    }

    for (const button of tablist.querySelectorAll<HTMLButtonElement>('.copy-cmd')) {
      button.addEventListener('click', async () => {
        const command = button.dataset.command || '';
        const status = button.parentElement?.querySelector<HTMLElement>('.copy-status') ?? null;
        try {
          await navigator.clipboard.writeText(command);
          button.dataset.copied = 'true';
          if (status) {
            status.innerHTML = '<span class="lang-zh">已复制</span><span class="lang-en">copied</span>';
          }
        } catch {
          if (status) {
            status.innerHTML = '<span class="lang-zh">复制失败，请手动选中</span><span class="lang-en">copy blocked — select manually</span>';
          }
        }
        window.setTimeout(() => {
          delete button.dataset.copied;
          if (status) status.textContent = '';
        }, 2400);
      });
    }
  }
</script>
