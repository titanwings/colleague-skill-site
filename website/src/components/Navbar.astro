---
/**
 * Top chrome — wordmark, in-page anchors, community links, language + theme.
 *
 * The bar stays `position: fixed` (out of flow) exactly like the previous
 * version so the untouched page shells keep their own top padding; the paper
 * background + hairline fade in on scroll.
 *
 * The mobile panel is a real disclosure: `aria-expanded` on the trigger,
 * Escape closes and returns focus to the trigger, outside clicks close it, and
 * focus moves into the panel when it opens.
 */
import { BRAND } from '../data/brand';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const anchors = [
  { href: `${base}/#features`, zh: '功能', en: 'Features' },
  { href: `${base}/#how-it-works`, zh: '如何工作', en: 'How it works' },
];
const galleryHref = `${base}/gallery/`;
const onGallery = currentPath.includes('/gallery');

const linkClass =
  'inline-flex items-center gap-1.5 rounded-pill px-3 py-2 font-grotesk text-sm text-ink-muted transition-colors hover:text-ink';
---

<header id="navbar" data-navbar class="fixed inset-x-0 top-0 z-50">
  <div
    data-navbar-bg
    class="pointer-events-none absolute inset-0 border-b border-line bg-paper/85 opacity-0 backdrop-blur transition-opacity duration-300"
  >
  </div>

  <nav aria-label="主导航 / Main navigation" class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4 md:grid md:grid-cols-[1fr_auto_1fr]">
      <!-- Wordmark: the name comes from BRAND, the plate is decoration only. -->
      <a href={`${base}/`} class="group inline-flex items-center gap-2.5 md:justify-self-start" aria-label={BRAND.name}>
        <span
          aria-hidden="true"
          class="flex h-7 w-7 items-center justify-center rounded-[10px] border border-line bg-paper-raised font-mono text-sm leading-none text-accent-soft transition-colors group-hover:border-accent/45"
          >.</span
        >
        <span class="font-grotesk text-[15px] font-semibold tracking-tight text-ink">{BRAND.name}</span>
      </a>

      <!-- Desktop anchors -->
      <ul class="hidden items-center gap-1 md:flex md:justify-self-center">
        {
          anchors.map((anchor) => (
            <li>
              <a href={anchor.href} class={linkClass}>
                <span class="lang-zh">{anchor.zh}</span>
                <span class="lang-en">{anchor.en}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={galleryHref}
            aria-current={onGallery ? 'page' : undefined}
            class:list={[linkClass, onGallery && 'text-ink']}
          >
            Gallery
          </a>
        </li>
      </ul>

      <!-- Desktop: community + preferences -->
      <div class="hidden items-center gap-1 md:flex md:justify-self-end">
        <a href={BRAND.repoUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          GitHub
        </a>
        <a href={BRAND.discordUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.036.055a19.904 19.904 0 0 0 5.993 3.03.077.077 0 0 0 .084-.028 13.99 13.99 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .036-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
            ></path>
          </svg>
          Discord
        </a>
        <span aria-hidden="true" class="mx-1 h-4 w-px bg-line"></span>
        <LangToggle />
        <ThemeToggle />
      </div>

      <!-- Mobile: preferences move into the panel, the trigger stays here. -->
      <div class="flex items-center gap-1.5 md:hidden">
        <ThemeToggle />
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="site-menu"
          aria-label="打开菜单 / Open menu"
          class="inline-flex h-9 w-9 items-center justify-center rounded-pill border border-line text-ink-muted transition-colors hover:border-accent/50 hover:text-ink"
        >
          <svg data-menu-icon="open" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg data-menu-icon="close" class="hidden h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile disclosure panel -->
  <div
    id="site-menu"
    data-menu
    hidden
    class="relative border-t border-line bg-paper md:hidden"
  >
    <ul class="mx-auto max-w-7xl px-4 py-4 sm:px-6">
      {
        anchors.map((anchor) => (
          <li>
            <a
              href={anchor.href}
              data-menu-link
              class="flex items-center justify-between border-b border-line py-3 font-display text-lg text-ink"
            >
              <span class="lang-zh">{anchor.zh}</span>
              <span class="lang-en">{anchor.en}</span>
              <span aria-hidden="true" class="font-mono text-xs text-ink-muted">↓</span>
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={galleryHref}
          data-menu-link
          aria-current={onGallery ? 'page' : undefined}
          class="flex items-center justify-between border-b border-line py-3 font-display text-lg text-ink"
        >
          Gallery
          <span aria-hidden="true" class="font-mono text-xs text-ink-muted">↓</span>
        </a>
      </li>
      <li>
        <a
          href={BRAND.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-menu-link
          class="flex items-center justify-between border-b border-line py-3 font-grotesk text-sm text-ink-muted"
        >
          GitHub
          <span aria-hidden="true" class="font-mono text-xs">↗</span>
        </a>
      </li>
      <li>
        <a
          href={BRAND.discordUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-menu-link
          class="flex items-center justify-between py-3 font-grotesk text-sm text-ink-muted"
        >
          Discord
          <span aria-hidden="true" class="font-mono text-xs">↗</span>
        </a>
      </li>
    </ul>

    <div class="mx-auto flex max-w-7xl items-center gap-2 border-t border-line px-4 py-4 sm:px-6">
      <LangToggle />
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu]');
  const openIcon = document.querySelector<SVGElement>('[data-menu-icon="open"]');
  const closeIcon = document.querySelector<SVGElement>('[data-menu-icon="close"]');
  const navbarBg = document.querySelector<HTMLElement>('[data-navbar-bg]');
  const header = document.querySelector<HTMLElement>('[data-navbar]');

  const OPEN_LABEL = '打开菜单 / Open menu';
  const CLOSE_LABEL = '关闭菜单 / Close menu';

  function setOpen(open: boolean, moveFocus = false) {
    if (!toggle || !panel) return;
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? CLOSE_LABEL : OPEN_LABEL);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    if (open && moveFocus) {
      panel.querySelector<HTMLElement>('a, button')?.focus();
    }
  }

  const isOpen = () => !!panel && !panel.hidden;

  toggle?.addEventListener('click', () => {
    const next = !isOpen();
    setOpen(next, next);
  });

  // Escape closes and hands focus back to the trigger, so keyboard users are
  // never dropped at the top of the document.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !isOpen()) return;
    setOpen(false);
    toggle?.focus();
  });

  // Pointer outside the header closes it without stealing focus.
  document.addEventListener('click', (event) => {
    if (!isOpen() || !header) return;
    if (!header.contains(event.target as Node)) setOpen(false);
  });

  // Following a link inside the panel closes it (the browser keeps focus).
  panel?.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Rotating to the desktop layout must not leave a stale open panel behind.
  window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });

  // Paper background + hairline appear once the page leaves the top.
  const onScroll = () => {
    const scrolled = window.scrollY > 12;
    navbarBg?.classList.toggle('opacity-0', !scrolled);
    navbarBg?.classList.toggle('opacity-100', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
