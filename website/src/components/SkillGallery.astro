---
import SkillCard from './SkillCard.astro';
import { ALL_CULTURES, ALL_TAGS } from '../lib/skills';
import type { SkillMeta } from '../types/skill';

interface Props {
  skills: SkillMeta[];
  base: string;
}

const { skills, base } = Astro.props;

/** Chinese gloss for the canonical English tag ids. */
const TAG_LABELS: Record<string, { zh: string; en: string }> = {
  frontend: { zh: '前端', en: 'frontend' },
  backend: { zh: '后端', en: 'backend' },
  security: { zh: '安全', en: 'security' },
  devops: { zh: '运维', en: 'devops' },
  data: { zh: '数据', en: 'data' },
  design: { zh: '设计', en: 'design' },
  product: { zh: '产品', en: 'product' },
  hr: { zh: '人力', en: 'hr' },
  management: { zh: '管理', en: 'management' },
  other: { zh: '其他', en: 'other' },
};

const CULTURE_LABELS: Record<string, { zh: string; en: string }> = {
  '字节风': { zh: '字节风', en: 'ByteDance' },
  '阿里风': { zh: '阿里风', en: 'Alibaba' },
  '腾讯风': { zh: '腾讯风', en: 'Tencent' },
  '华为风': { zh: '华为风', en: 'Huawei' },
  '创业风': { zh: '创业风', en: 'Startup' },
  '外企风': { zh: '外企风', en: 'MNC' },
  '国企风': { zh: '国企风', en: 'SOE' },
  '其他': { zh: '其他', en: 'Other' },
};

const skillType = (s: SkillMeta): 'skill' | 'meta-skill' => (s.type === 'meta-skill' ? 'meta-skill' : 'skill');

/**
 * Searchable text for one Skill, lower-cased once at build time so the client
 * filter stays a single `String.includes` per record.
 */
function searchIndex(s: SkillMeta): string {
  return [
    s.name,
    s.slug,
    s.description,
    s.description_en,
    s.type,
    s.level,
    s.level_en,
    s.company_culture,
    s.author?.name,
    s.author?.github,
    ...(s.tags ?? []),
    ...(s.personality ?? []),
  ]
    .filter((v): v is string => typeof v === 'string' && v.length > 0)
    .join(' ')
    .toLowerCase();
}

const countBy = (values: string[]): Map<string, number> => {
  const counts = new Map<string, number>();
  for (const value of values) counts.set(value, (counts.get(value) ?? 0) + 1);
  return counts;
};

const typeCounts = countBy(skills.map(skillType));
const tagCounts = countBy(skills.flatMap((s) => s.tags ?? []));
const cultureCounts = countBy(skills.map((s) => s.company_culture).filter((v): v is string => Boolean(v)));

/**
 * Only offer options the catalog actually contains (canonical order first), so
 * no chip is a dead end — 4 of the 8 `ALL_CULTURES` values have zero Skills.
 */
const tagOptions = [
  ...ALL_TAGS.filter((tag) => tagCounts.has(tag)),
  ...[...tagCounts.keys()].filter((tag) => !(ALL_TAGS as readonly string[]).includes(tag)).sort(),
].map((tag) => ({ value: tag, count: tagCounts.get(tag) ?? 0, label: TAG_LABELS[tag] ?? { zh: tag, en: tag } }));

const cultureOptions = [
  ...ALL_CULTURES.filter((culture) => cultureCounts.has(culture)),
  ...[...cultureCounts.keys()].filter((culture) => !(ALL_CULTURES as readonly string[]).includes(culture)).sort(),
].map((culture) => ({
  value: culture,
  count: cultureCounts.get(culture) ?? 0,
  label: CULTURE_LABELS[culture] ?? { zh: culture, en: culture },
}));

const typeOptions = [
  { value: 'skill', count: typeCounts.get('skill') ?? 0 },
  { value: 'meta-skill', count: typeCounts.get('meta-skill') ?? 0 },
];
---

<div id="gallery-root">
  <!-- ------------------------------------------------------------ controls -->
  <section aria-labelledby="gallery-filter-heading">
    <h2 id="gallery-filter-heading" class="sr-only">
      <span class="lang-zh">筛选与排序</span>
      <span class="lang-en">Filter and sort</span>
    </h2>

    <div class="flex flex-col gap-5">
      <!-- Search -->
      <div>
        <label
          for="gallery-search"
          class="block font-grotesk text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted"
        >
          <span class="lang-zh">搜索</span>
          <span class="lang-en">Search</span>
        </label>
        <div class="relative mt-2 max-w-md">
          <svg
            class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-muted"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            type="search"
            id="gallery-search"
            name="q"
            autocomplete="off"
            spellcheck="false"
            data-placeholder-zh="名称、简介、标签、作者…"
            data-placeholder-en="Name, summary, tag, author…"
            placeholder="名称、简介、标签、作者…"
            class="w-full rounded-lg border border-line bg-paper-raised py-2.5 pl-10 pr-3 text-sm text-ink placeholder:text-ink-muted focus:border-accent/60 focus:outline-none"
          />
        </div>
      </div>

      <!-- Type -->
      <div class="flex flex-col gap-2 border-t border-line pt-4 sm:flex-row sm:items-baseline sm:gap-6">
        <span
          id="filter-type-label"
          class="w-24 shrink-0 font-grotesk text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted"
        >
          <span class="lang-zh">类型</span>
          <span class="lang-en">Type</span>
        </span>
        <div class="flex flex-wrap gap-2" role="group" aria-labelledby="filter-type-label">
          <button type="button" class="chip" data-filter="type" data-value="" aria-pressed="true">
            <span class="lang-zh">全部</span>
            <span class="lang-en">All</span>
            <span class="chip-count">{skills.length}</span>
          </button>
          {typeOptions.map((option) => (
            <button
              type="button"
              class="chip"
              data-filter="type"
              data-value={option.value}
              aria-pressed="false"
            >
              {option.value}
              <span class="chip-count">{option.count}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Tags -->
      <div class="flex flex-col gap-2 border-t border-line pt-4 sm:flex-row sm:items-baseline sm:gap-6">
        <span
          id="filter-tag-label"
          class="w-24 shrink-0 font-grotesk text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted"
        >
          <span class="lang-zh">标签</span>
          <span class="lang-en">Tag</span>
        </span>
        <div class="flex flex-wrap gap-2" role="group" aria-labelledby="filter-tag-label">
          <button type="button" class="chip" data-filter="tag" data-value="" aria-pressed="true">
            <span class="lang-zh">全部</span>
            <span class="lang-en">All</span>
          </button>
          {tagOptions.map((option) => (
            <button
              type="button"
              class="chip"
              data-filter="tag"
              data-value={option.value}
              aria-pressed="false"
            >
              <span class="lang-zh">{option.label.zh}</span>
              <span class="lang-en">{option.label.en}</span>
              <span class="chip-count">{option.count}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Culture -->
      <div class="flex flex-col gap-2 border-t border-line pt-4 sm:flex-row sm:items-baseline sm:gap-6">
        <span
          id="filter-culture-label"
          class="w-24 shrink-0 font-grotesk text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted"
        >
          <span class="lang-zh">文化</span>
          <span class="lang-en">Culture</span>
        </span>
        <div class="flex flex-wrap gap-2" role="group" aria-labelledby="filter-culture-label">
          <button type="button" class="chip" data-filter="culture" data-value="" aria-pressed="true">
            <span class="lang-zh">全部</span>
            <span class="lang-en">All</span>
          </button>
          {cultureOptions.map((option) => (
            <button
              type="button"
              class="chip"
              data-filter="culture"
              data-value={option.value}
              aria-pressed="false"
            >
              <span class="lang-zh">{option.label.zh}</span>
              <span class="lang-en">{option.label.en}</span>
              <span class="chip-count">{option.count}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Sort -->
      <div class="flex flex-col gap-2 border-t border-line pt-4 sm:flex-row sm:items-baseline sm:gap-6">
        <span
          id="filter-sort-label"
          class="w-24 shrink-0 font-grotesk text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted"
        >
          <span class="lang-zh">排序</span>
          <span class="lang-en">Sort</span>
        </span>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-labelledby="filter-sort-label">
          <!-- `pinned` reproduces the build-time order from getAllSkills(), so the
               first paint does not reorder under the reader. -->
          <button type="button" class="chip" data-sort="pinned" aria-pressed="true">
            <span class="lang-zh">推荐</span>
            <span class="lang-en">Pinned</span>
          </button>
          <button type="button" class="chip" data-sort="stars" aria-pressed="false">
            <span class="lang-zh">Stars</span>
            <span class="lang-en">Stars</span>
          </button>
          <button type="button" class="chip" data-sort="newest" aria-pressed="false">
            <span class="lang-zh">最新</span>
            <span class="lang-en">Newest</span>
          </button>
          <button type="button" id="gallery-reset" class="chip gallery-hidden ml-1" data-reset>
            <span class="lang-zh">清除筛选</span>
            <span class="lang-en">Reset</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- results -->
  <div class="mt-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-line pt-6">
    <h2 id="gallery-results-heading" class="font-display text-2xl font-semibold tracking-tight text-ink">
      <span class="lang-zh">全部 Skill</span>
      <span class="lang-en">All Skills</span>
    </h2>
    <p id="gallery-count" class="font-mono text-sm text-ink-muted" role="status">
      <span class="lang-zh">
        共 <span data-count>{skills.length}</span> 个 · 第 <span data-page>1</span>/<span data-pages
          >1</span
        > 页
      </span>
      <span class="lang-en">
        <span data-count>{skills.length}</span> results · page <span data-page>1</span>/<span
          data-pages>1</span
        >
      </span>
    </p>
  </div>

  <ul
    id="skills-grid"
    class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
  >
    {skills.map((skill) => (
      <li
        class="skill-item"
        data-slug={skill.slug}
        data-name={skill.name}
        data-search={searchIndex(skill)}
        data-type={skillType(skill)}
        data-tags={(skill.tags ?? []).join(' ')}
        data-culture={skill.company_culture ?? ''}
        data-stars={skill.stars ?? 0}
        data-created={skill.created_at}
        data-pinned={skill.pinned ? 'true' : 'false'}
      >
        <SkillCard skill={skill} base={base} />
      </li>
    ))}
  </ul>

  <!-- Empty state -->
  <div id="gallery-empty" class="gallery-hidden border-t border-line py-20 text-center">
    <p class="font-mono text-sm uppercase tracking-[0.18em] text-ink-muted">0 / 0</p>
    <p class="mt-4 font-display text-2xl text-ink">
      <span class="lang-zh">没有匹配的 Skill</span>
      <span class="lang-en">No Skill matches</span>
    </p>
    <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-ink-muted">
      <span class="lang-zh">换一个关键词，或者清掉筛选条件重新看看。</span>
      <span class="lang-en">Try another keyword, or clear the filters and browse again.</span>
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <button type="button" class="chip" data-reset>
        <span class="lang-zh">清除筛选</span>
        <span class="lang-en">Reset filters</span>
      </button>
      <a
        href="https://github.com/titanwings/colleague-skill-site/issues/new?template=submit-skill.yml"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-accent-soft"
      >
        <span class="lang-zh">提交一个新的 →</span>
        <span class="lang-en">Submit a new one →</span>
      </a>
    </div>
  </div>

  <!-- Pagination -->
  <nav
    id="gallery-pagination"
    class="gallery-hidden mt-10 flex items-center justify-center gap-3"
    aria-label="分页"
  >
    <button type="button" id="page-prev" class="chip">
      <span aria-hidden="true">←</span>
      <span class="lang-zh">上一页</span>
      <span class="lang-en">Prev</span>
    </button>
    <span id="page-indicator" class="font-mono text-sm text-ink-muted"></span>
    <button type="button" id="page-next" class="chip">
      <span class="lang-zh">下一页</span>
      <span class="lang-en">Next</span>
      <span aria-hidden="true">→</span>
    </button>
  </nav>
</div>

<style is:global>
  /*
   * Chip styling for the filter bar. Kept in a global block on purpose: every
   * selector is namespaced by `#gallery-root`, so nothing leaks, and the block
   * is immune to Astro's per-component scope rewriting. Language pairing is NOT
   * handled here — `global.css` owns `.lang-zh` / `.lang-en`.
   */

  /* Filter / sort / pagination chip. Selection is driven by `aria-pressed`,
     so the visual state and the accessible state can never drift apart. */
  #gallery-root .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid rgb(var(--line));
    border-radius: 999px;
    background: rgb(var(--paper-raised));
    color: rgb(var(--ink-muted));
    font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  #gallery-root .chip:hover {
    border-color: rgb(var(--accent) / 0.45);
    color: rgb(var(--ink));
  }
  #gallery-root .chip[aria-pressed='true'] {
    border-color: rgb(var(--accent) / 0.6);
    background: rgb(var(--accent-wash));
    color: rgb(var(--ink));
  }
  #gallery-root .chip-count {
    color: rgb(var(--ink-muted));
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
  }
  /* Declared after `.chip` so state hiding wins at equal specificity. */
  #gallery-root .gallery-hidden {
    display: none;
  }
</style>

<script>
  const PAGE_SIZE = 24;

  interface Record_ {
    el: HTMLLIElement;
    search: string;
    type: string;
    tags: string[];
    culture: string;
    stars: number;
    created: string;
    pinned: boolean;
  }

  interface State {
    query: string;
    type: string;
    tag: string;
    culture: string;
    sort: string;
    page: number;
  }

  const root = document.getElementById('gallery-root');
  const grid = document.getElementById('skills-grid');
  const emptyState = document.getElementById('gallery-empty');
  const pagination = document.getElementById('gallery-pagination');
  const searchInput = document.getElementById('gallery-search') as HTMLInputElement | null;
  const resetButtons = document.querySelectorAll<HTMLButtonElement>('[data-reset]');
  const prevButton = document.getElementById('page-prev') as HTMLButtonElement | null;
  const nextButton = document.getElementById('page-next') as HTMLButtonElement | null;
  const pageIndicator = document.getElementById('page-indicator');

  if (root && grid) {
    /** Snapshot of everything the filter needs, read from the DOM exactly once. */
    const records: Record_[] = Array.from(grid.querySelectorAll<HTMLLIElement>('.skill-item')).map((el) => ({
      el,
      search: el.dataset.search || '',
      type: el.dataset.type || 'skill',
      tags: (el.dataset.tags || '').split(' ').filter(Boolean),
      culture: el.dataset.culture || '',
      stars: Number(el.dataset.stars || '0'),
      created: el.dataset.created || '',
      pinned: el.dataset.pinned === 'true',
    }));

    const state: State = { query: '', type: '', tag: '', culture: '', sort: 'pinned', page: 1 };

    /** Does one catalog entry satisfy every active filter? (pure) */
    function skillMatches(record: Record_, current: State): boolean {
      if (current.type && record.type !== current.type) return false;
      if (current.tag && !record.tags.includes(current.tag)) return false;
      if (current.culture && record.culture !== current.culture) return false;
      if (current.query && !record.search.includes(current.query)) return false;
      return true;
    }

    /** Ordering only — no filtering side effects. (pure) */
    function compareSkills(a: Record_, b: Record_, sort: string): number {
      if (sort === 'newest') return b.created.localeCompare(a.created) || b.stars - a.stars;
      if (sort === 'stars') return b.stars - a.stars || b.created.localeCompare(a.created);
      // 'pinned' mirrors getAllSkills(): pinned first, then stars, then newest.
      if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
      return b.stars - a.stars || b.created.localeCompare(a.created);
    }

    /** Filter → sort → paginate. The single place the visible set is decided. */
    function selectSkills(all: Record_[], current: State) {
      const matched = all.filter((record) => skillMatches(record, current)).sort((a, b) => compareSkills(a, b, current.sort));
      const pageCount = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
      const page = Math.min(Math.max(current.page, 1), pageCount);
      const start = (page - 1) * PAGE_SIZE;
      return { matched, page, pageCount, pageItems: matched.slice(start, start + PAGE_SIZE) };
    }

    function render(): void {
      const { matched, page, pageCount, pageItems } = selectSkills(records, state);
      state.page = page;

      const shown = new Set(pageItems.map((record) => record.el));
      for (const record of records) record.el.hidden = !shown.has(record.el);
      // Re-append in sorted order so reading order matches the sort control.
      for (const record of pageItems) grid!.appendChild(record.el);

      for (const node of document.querySelectorAll<HTMLElement>('[data-count]')) {
        node.textContent = String(matched.length);
      }
      for (const node of document.querySelectorAll<HTMLElement>('[data-page]')) {
        node.textContent = String(page);
      }
      for (const node of document.querySelectorAll<HTMLElement>('[data-pages]')) {
        node.textContent = String(pageCount);
      }

      const isEmpty = matched.length === 0;
      grid!.classList.toggle('gallery-hidden', isEmpty);
      emptyState?.classList.toggle('gallery-hidden', !isEmpty);

      const isPaged = !isEmpty && pageCount > 1;
      pagination?.classList.toggle('gallery-hidden', !isPaged);
      if (pageIndicator) pageIndicator.textContent = `${page} / ${pageCount}`;
      if (prevButton) prevButton.disabled = page <= 1;
      if (nextButton) nextButton.disabled = page >= pageCount;

      const filtersActive = Boolean(state.query || state.type || state.tag || state.culture);
      for (const button of resetButtons) button.classList.toggle('gallery-hidden', !filtersActive);
    }

    /** Single-select chip groups: `aria-pressed` is the source of truth. */
    function setPressed(selector: string, active: HTMLElement): void {
      for (const chip of document.querySelectorAll<HTMLElement>(selector)) {
        chip.setAttribute('aria-pressed', String(chip === active));
      }
    }

    function resetFilters(): void {
      state.query = '';
      state.type = '';
      state.tag = '';
      state.culture = '';
      state.page = 1;
      if (searchInput) searchInput.value = '';
      setPressed('[data-filter="type"]', document.querySelector('[data-filter="type"][data-value=""]')!);
      setPressed('[data-filter="tag"]', document.querySelector('[data-filter="tag"][data-value=""]')!);
      setPressed('[data-filter="culture"]', document.querySelector('[data-filter="culture"][data-value=""]')!);
      render();
    }

    for (const chip of document.querySelectorAll<HTMLElement>('[data-filter]')) {
      chip.addEventListener('click', () => {
        const key = chip.dataset.filter as 'type' | 'tag' | 'culture';
        state[key] = chip.dataset.value || '';
        state.page = 1;
        setPressed(`[data-filter="${key}"]`, chip);
        render();
      });
    }

    for (const chip of document.querySelectorAll<HTMLElement>('[data-sort]')) {
      chip.addEventListener('click', () => {
        state.sort = chip.dataset.sort || 'pinned';
        state.page = 1;
        setPressed('[data-sort]', chip);
        render();
      });
    }

    for (const button of resetButtons) button.addEventListener('click', resetFilters);

    searchInput?.addEventListener('input', () => {
      state.query = searchInput.value.trim().toLowerCase();
      state.page = 1;
      render();
    });

    function goToPage(next: number): void {
      state.page = next;
      render();
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root!.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    }
    prevButton?.addEventListener('click', () => goToPage(state.page - 1));
    nextButton?.addEventListener('click', () => goToPage(state.page + 1));

    // Bilingual placeholder: the input can only hold one string, so it follows
    // the document language instead of using a lang-zh/lang-en pair.
    function syncPlaceholder(): void {
      if (!searchInput) return;
      const isEn = document.documentElement.getAttribute('data-lang') === 'en';
      searchInput.placeholder = (isEn ? searchInput.dataset.placeholderEn : searchInput.dataset.placeholderZh) || '';
    }
    syncPlaceholder();
    new MutationObserver(syncPlaceholder).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-lang'],
    });

    // Read-only hook for the Playwright evidence script: it asserts against the
    // same visible set the UI renders instead of scraping pagination markup.
    (window as unknown as { __gallery?: unknown }).__gallery = {
      getState: () => ({ ...state }),
      visible: () =>
        selectSkills(records, state).pageItems.map((record) => ({
          slug: record.el.dataset.slug,
          name: record.el.dataset.name,
          stars: record.stars,
        })),
    };

    render();
  }
</script>
