---
/**
 * QuickStart — numbered steps.
 *
 * Step 01 embeds <AgentSwitcher />, so the install instructions are generated
 * from `src/data/agents.ts` instead of being hand-copied (the previous version
 * hard-coded two clone commands with stale repo names). Steps 02 and 03 keep
 * the existing copy: distill a conversation → a SKILL.md lands on disk → summon
 * it from the same host.
 *
 * Plate panels use only `plate-ink` shades: the accent/semantic tokens are
 * tuned for paper backgrounds and would drop below 4.5:1 on the dark plate.
 */
import AgentSwitcher from './AgentSwitcher.astro';
import { BRAND } from '../data/brand';
import { AGENTS } from '../data/agents';

const hostCount = AGENTS.length;
---

<section id="quickstart" class="border-b border-line py-20 lg:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <header class="max-w-3xl">
      <p class="section-label">Quick Start</p>
      <h2
        class="mt-6 font-display text-3xl font-semibold leading-[1.1] tracking-tight text-ink sm:text-4xl lg:text-5xl"
      >
        <span class="lang-zh">三步上手，五分钟，<span class="italic text-accent-soft">不是吹的</span></span>
        <span class="lang-en">Up in three steps. <span class="italic text-accent-soft">Five minutes.</span></span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted">
        <span class="lang-zh">选你的宿主，复制命令，剩下的交给 Skill。</span>
        <span class="lang-en">Pick your host, copy the command, and let the Skill do the rest.</span>
      </p>
    </header>

    <!-- 01 — install -->
    <div class="mt-14 grid gap-8 border-t border-line pt-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <p class="font-display text-3xl font-semibold text-accent-soft">01</p>
        <h3 class="mt-4 font-display text-2xl font-semibold text-ink">
          <span class="lang-zh">在你的 coding agent 里安装</span>
          <span class="lang-en">Install in your coding agent</span>
        </h3>
        <p class="mt-4 text-base leading-relaxed text-ink-muted">
          <span class="lang-zh">
            选一个宿主，拿到它的确切命令、确切安装目录和能力说明——{hostCount} 个宿主全部列出，不含糊。
          </span>
          <span class="lang-en">
            Pick a host and get its exact command, exact install directory and an honest capability note — all
            {hostCount} supported hosts are listed.
          </span>
        </p>
        <p class="mt-4 text-sm leading-relaxed text-ink-muted">
          <span class="lang-zh">
            Skill 本体遵循 <a
              href={BRAND.agentskillsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent-soft underline decoration-line underline-offset-4">AgentSkills 开放标准</a
            >：一份 SKILL.md，换宿主不用重写。
          </span>
          <span class="lang-en">
            The Skill itself follows the <a
              href={BRAND.agentskillsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent-soft underline decoration-line underline-offset-4">AgentSkills open standard</a
            >: one SKILL.md, no rewrite when you switch hosts.
          </span>
        </p>
      </div>
      <div class="min-w-0 lg:col-span-8">
        <AgentSwitcher id="quickstart-agent" />
      </div>
    </div>

    <!-- 02 — distill -->
    <div class="mt-14 grid gap-8 border-t border-line pt-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <p class="font-display text-3xl font-semibold text-accent-soft">02</p>
        <h3 class="mt-4 font-display text-2xl font-semibold text-ink">
          <span class="lang-zh">蒸馏 → 生成 Skill</span>
          <span class="lang-en">Distill → generate the Skill</span>
        </h3>
        <p class="mt-4 text-base leading-relaxed text-ink-muted">
          <span class="lang-zh">
            让它读一段对话、一批 code review 或一个仓库。采集的材料越多，生成的 Work Skill 与 Persona 越像本人。
          </span>
          <span class="lang-en">
            Point it at a conversation, a pile of code reviews or a repository. The more material it collects, the
            closer the generated Work Skill and Persona land.
          </span>
        </p>
        <p class="mt-4 text-sm leading-relaxed text-ink-muted">
          <span class="lang-zh">产物是一个目录：Work Skill、Persona 和一份可读的 SKILL.md。</span>
          <span class="lang-en">The output is a directory: Work Skill, Persona and a readable SKILL.md.</span>
        </p>
      </div>
      <div class="min-w-0 lg:col-span-8">
        <div class="code-block px-4 py-4 font-mono text-[13px] leading-relaxed sm:px-5">
          <p class="break-words text-plate-ink/60">
            <span class="lang-zh"># 蒸馏一段对话 → 一个 SKILL.md</span>
            <span class="lang-en"># distill a conversation → one SKILL.md</span>
          </p>
          <p class="mt-3 flex flex-wrap items-baseline gap-x-2 text-plate-ink">
            <span aria-hidden="true" class="text-plate-ink/50">❯</span>
            <span class="font-semibold">/distilly</span>
            <span class="text-plate-ink/60">
              <span class="lang-zh">把这段聊天蒸馏成 Skill</span>
              <span class="lang-en">distill this chat into a Skill</span>
            </span>
          </p>
          <div class="mt-3 space-y-1.5 text-plate-ink/70">
            <p>
              <span aria-hidden="true" class="text-plate-ink/50">✓</span>
              <span class="lang-zh">采集飞书 / Slack / 邮件里的对话 847 条</span>
              <span class="lang-en">847 messages collected from Feishu / Slack / email</span>
            </p>
            <p>
              <span aria-hidden="true" class="text-plate-ink/50">✓</span>
              <span class="lang-zh">提取 code review 评论 234 条</span>
              <span class="lang-en">234 code-review comments extracted</span>
            </p>
            <p>
              <span aria-hidden="true" class="text-plate-ink/50">⚡</span>
              <span class="lang-zh">生成 Work Skill + Persona …</span>
              <span class="lang-en">generating Work Skill + Persona …</span>
            </p>
          </div>
          <p class="mt-4 break-words border-t border-plate-line pt-3 text-plate-ink/70">
            <span aria-hidden="true" class="text-plate-ink/50">✓</span>
            <span class="lang-zh">完成 →</span>
            <span class="lang-en">done →</span>
            <code class="font-semibold text-plate-ink">colleagues/security-engineer-wang/SKILL.md</code>
          </p>
        </div>
      </div>
    </div>

    <!-- 03 — summon -->
    <div class="mt-14 grid gap-8 border-t border-line pt-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <p class="font-display text-3xl font-semibold text-accent-soft">03</p>
        <h3 class="mt-4 font-display text-2xl font-semibold text-ink">
          <span class="lang-zh">在宿主里调用</span>
          <span class="lang-en">Summon it in your host</span>
        </h3>
        <p class="mt-4 text-base leading-relaxed text-ink-muted">
          <span class="lang-zh">
            同一个宿主、同一个会话里直接提问，不用切换工具：它按那个人的方式回答、按那个人的优先级挑问题。
          </span>
          <span class="lang-en">
            Ask in the same host and the same session — no tool switching. It answers the way that person would and
            triages by their priorities.
          </span>
        </p>
      </div>
      <div class="min-w-0 lg:col-span-8">
        <div class="code-block px-4 py-4 font-mono text-[13px] leading-relaxed sm:px-5">
          <p class="break-words text-plate-ink/60">
            <span class="lang-zh"># 装完之后，在同一个宿主里召唤</span>
            <span class="lang-en"># once installed, summon from the same host</span>
          </p>
          <p class="mt-3 flex flex-wrap items-baseline gap-x-2 text-plate-ink">
            <span aria-hidden="true" class="text-plate-ink/50">❯</span>
            <span class="font-semibold">/security-engineer-wang</span>
            <span class="text-plate-ink/70">
              <span class="lang-zh">帮我看看这个 API 有没有安全问题</span>
              <span class="lang-en">check this API for security issues</span>
            </span>
          </p>
          <p class="mt-4 break-words border-t border-plate-line pt-3 text-plate-ink/70">
            <span class="lang-zh">
              一个 Skill 一个目录：<code class="text-plate-ink">colleagues/&lt;slug&gt;/</code>，同一份 SKILL.md 在任何宿主里都能加载。
            </span>
            <span class="lang-en">
              One directory per Skill — <code class="text-plate-ink">colleagues/&lt;slug&gt;/</code> — and the same
              SKILL.md loads in every host.
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
