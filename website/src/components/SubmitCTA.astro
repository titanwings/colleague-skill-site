---
/**
 * Closing call to action — one plate band on the paper page.
 *
 * The plate is the only high-contrast block in the chrome, which is how the
 * editorial layouts sign off; everything inside it uses `plate-*` tokens
 * (never `ink-*`, which is tuned for paper) so it reads in both themes.
 *
 * The three process lines are numbered rather than badged — no emoji, no
 * gradient panel, no blurred glow.
 */
import { BRAND } from '../data/brand';

const base = import.meta.env.BASE_URL;

const process = [
  { numZh: '01', numEn: '01', zh: '填一份 Issue 表单', en: 'File the Issue form' },
  { numZh: '02', numEn: '02', zh: 'CI 校验格式', en: 'CI validates the format' },
  { numZh: '03', numEn: '03', zh: '合并后进入 Gallery', en: 'Live in the Gallery on merge' },
];
---

<section class="border-t border-line py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal rounded-card border border-plate-line bg-plate px-6 py-12 text-plate-ink sm:px-10 md:px-14 md:py-16">
      <p class="font-grotesk text-xs font-medium uppercase tracking-[0.18em] text-accent">
        <span class="lang-zh">提交 · Contribute</span>
        <span class="lang-en">Contribute · 提交</span>
      </p>

      <h2 class="mt-5 max-w-2xl font-display text-3xl font-semibold leading-[1.2] tracking-tight text-plate-ink md:text-4xl">
        <span class="lang-zh">蒸馏了什么好东西？分享出来。</span>
        <span class="lang-en">Distilled something good? Share it.</span>
      </h2>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-plate-ink/80">
        <span class="lang-zh">你蒸馏的那个人，可能正是别人找了很久的。大牛、导师、某本书的作者、某个领域的专家——提交到 Gallery，让更多人用得上。</span>
        <span class="lang-en">The person you distilled may be exactly who someone else has been looking for. An engineer, a mentor, an author, an expert — submit it to the Gallery and let others summon them too.</span>
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={BRAND.submitUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-accent-deep px-6 py-3 text-base font-semibold text-paper transition-colors hover:bg-accent-soft"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M12 5v14M5 12h14"></path>
          </svg>
          <span class="lang-zh">提交我的 Skill</span>
          <span class="lang-en">Submit my Skill</span>
        </a>
        <a
          href={`${base}/gallery/`}
          class="inline-flex items-center gap-2 rounded-lg border border-plate-line px-6 py-3 text-base font-medium text-plate-ink transition-colors hover:border-accent hover:text-accent"
        >
          <span class="lang-zh">先逛逛 Gallery</span>
          <span class="lang-en">Browse the Gallery</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="mt-12 grid gap-6 border-t border-plate-line pt-8 sm:grid-cols-3">
        {
          process.map((item) => (
            <li class="flex items-baseline gap-3">
              <span class="font-mono text-[11px] tracking-[0.14em] text-accent">
                <span class="lang-zh">{item.numZh}</span>
                <span class="lang-en">{item.numEn}</span>
              </span>
              <span class="font-grotesk text-sm text-plate-ink/80">
                <span class="lang-zh">{item.zh}</span>
                <span class="lang-en">{item.en}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
