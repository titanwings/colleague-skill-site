---
import type { SkillMeta } from '../types/skill';

interface Props {
  skill: SkillMeta;
  base: string;
}

const { skill, base } = Astro.props;

const NEW_WINDOW_DAYS = 14;
const isNew = (() => {
  const created = Date.parse(skill.created_at ?? '');
  if (!Number.isFinite(created)) return false;
  const ageMs = Date.now() - created;
  return ageMs >= 0 && ageMs <= NEW_WINDOW_DAYS * 24 * 60 * 60 * 1000;
})();

/** `skill` / `meta-skill`; YAML without a `type` field is treated as `skill`. */
const skillType = skill.type === 'meta-skill' ? 'meta-skill' : 'skill';

function formatStars(n: number): string {
  if (n < 1000) return String(n);
  if (n < 10000) {
    // String surgery rather than a `/\\.0$/` regex: that literal trips Astro's
    // export hoisting in page frontmatter (same code lives in [slug].astro).
    const rounded = (n / 1000).toFixed(1);
    return (rounded.endsWith('.0') ? rounded.slice(0, -2) : rounded) + 'k';
  }
  return Math.round(n / 1000) + 'k';
}

const cultureMap: Record<string, string> = {
  '字节风': 'ByteDance',
  '阿里风': 'Alibaba',
  '腾讯风': 'Tencent',
  '华为风': 'Huawei',
  '创业风': 'Startup',
  '外企风': 'MNC',
  '国企风': 'SOE',
  '其他': 'Other',
};

const personalityMap: Record<string, string> = {
  '严谨': 'Rigorous',
  '直接': 'Direct',
  '完美主义': 'Perfectionist',
  '务实': 'Pragmatic',
  '细心': 'Meticulous',
  '坦诚': 'Candid',
  '经验丰富': 'Seasoned',
  '不废话': 'No BS',
  '现实主义': 'Realist',
  '黑色幽默': 'Dark Humor',
  '直击要害': 'Straight Shooter',
  '去魅思维': 'Demystifier',
  '直接压迫': 'Bluntly Direct',
  '人文关怀': 'Humanist',
  '理性克制': 'Rational',
  '举例达人': 'Example Pro',
};

const tags = skill.tags ?? [];
const personality = skill.personality ?? [];
const href = `${base}/gallery/${skill.slug}/`;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-card border border-line bg-paper-raised p-5 text-ink no-underline transition-colors duration-200 hover:border-accent/60 hover:no-underline"
>
  <!-- Type + status -->
  <div class="flex items-center justify-between gap-3">
    <span class="font-grotesk text-[11px] font-medium uppercase tracking-[0.16em] text-ink-muted">
      {skillType}
    </span>
    <span class="flex items-center gap-2">
      {skill.pinned && (
        <span
          class="rounded-pill border border-accent/35 bg-accent-wash px-2 py-0.5 font-grotesk text-[11px] uppercase tracking-[0.12em] text-accent-deep"
        >
          <span class="lang-zh">置顶</span>
          <span class="lang-en">pinned</span>
        </span>
      )}
      {isNew && !skill.pinned && (
        <span class="flex items-center gap-1.5 font-grotesk text-[11px] uppercase tracking-[0.12em] text-ok">
          <span class="h-1.5 w-1.5 rounded-pill bg-ok" aria-hidden="true"></span>new
        </span>
      )}
    </span>
  </div>

  <!-- Name -->
  <h3 class="mt-3 flex items-start justify-between gap-3 font-display text-xl font-semibold leading-snug text-ink">
    <span>{skill.name}</span>
    <span
      class="mt-1 shrink-0 font-mono text-sm text-ink-muted transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-accent-soft"
      aria-hidden="true">→</span
    >
  </h3>

  {skill.level && (
    <p class="mt-1 font-mono text-xs text-ink-muted">
      <span class="lang-zh">{skill.level}</span>
      <span class="lang-en">{skill.level_en || skill.level}</span>
    </p>
  )}

  <!-- One-line summary -->
  <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-ink-soft">
    <span class="lang-zh">{skill.description}</span>
    <span class="lang-en">{skill.description_en || skill.description}</span>
  </p>

  <!-- Tags -->
  <div class="mt-4 flex flex-wrap gap-1.5">
    {tags.slice(0, 3).map((tag) => (
      <span class="rounded-pill border border-line bg-paper-sunk px-2 py-0.5 font-mono text-[11px] text-ink-muted">
        {tag}
      </span>
    ))}
    {personality.slice(0, 2).map((p) => (
      <span class="rounded-pill border border-line bg-paper-sunk px-2 py-0.5 font-mono text-[11px] text-ink-muted">
        <span class="lang-zh">{p}</span>
        <span class="lang-en">{personalityMap[p] || p}</span>
      </span>
    ))}
    {skill.company_culture && (
      <span class="rounded-pill border border-line bg-paper-sunk px-2 py-0.5 font-mono text-[11px] text-ink-muted">
        <span class="lang-zh">{skill.company_culture}</span>
        <span class="lang-en">{cultureMap[skill.company_culture] || skill.company_culture}</span>
      </span>
    )}
  </div>

  <!-- Author + stars -->
  <div class="mt-4 flex items-center justify-between gap-3 border-t border-line pt-4">
    <span class="flex min-w-0 items-center gap-2">
      <img
        src={`https://github.com/${skill.author.github}.png?size=48`}
        alt=""
        width="20"
        height="20"
        class="h-5 w-5 shrink-0 rounded-pill border border-line object-cover"
        loading="lazy"
        decoding="async"
        onerror="this.remove()"
      />
      <span class="truncate font-mono text-xs text-ink-muted">{skill.author.name}</span>
    </span>

    <span class="flex shrink-0 items-center gap-3 font-mono text-xs text-ink-muted">
      {typeof skill.stars === 'number' && (
        <span
          class="flex items-center gap-1"
          title={skill.stars_synced_at
            ? `GitHub stars · synced ${skill.stars_synced_at.slice(0, 10)}`
            : 'GitHub stars'}
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
            ></path>
          </svg>
          {formatStars(skill.stars)}
        </span>
      )}
      <span>{skill.created_at}</span>
    </span>
  </div>
</a>
