---
/**
 * "How it works" — a numbered editorial list instead of icon tiles.
 *
 * Three steps on hairline rules (`<ol>` so the numbering is real structure),
 * each with one detail line in mono. The use-case row below replaces the old
 * emoji grid with mono `U·01` specimens.
 */
const steps = [
  {
    titleZh: '喂原材料',
    titleEn: 'Dump everything in',
    bodyZh: '飞书记录、邮件线程、GitHub PR、截图、录音转写——能找到的全扔进来。一段群聊也能起步。',
    bodyEn: 'Feishu threads, email chains, GitHub PRs, screenshots, transcripts — throw in whatever you can find. A single group chat is a start.',
    detailZh: '越多越准 · 十条也够用',
    detailEn: 'More is better · ten is enough',
  },
  {
    titleZh: '自动蒸馏',
    titleEn: 'Auto distillation',
    bodyZh: '模型提取工作逻辑、决策风格与表达方式，生成结构化的 Work Skill 和 5 层 Persona。你不用动手整理。',
    bodyEn: 'The model extracts decision logic, work style and phrasing into a structured Work Skill plus a 5-layer Persona. No manual clean-up.',
    detailZh: '产出：一份 SKILL.md',
    detailEn: 'Output: one SKILL.md',
  },
  {
    titleZh: '随叫随到',
    titleEn: 'Summon anytime',
    bodyZh: '在 Claude Code 或任何支持 AgentSkills 的 Agent 里 / 一下——问专业问题、请他 review、让他拍板。',
    bodyEn: 'Type / in Claude Code or any AgentSkills-capable agent — ask a domain question, request a review, get a decision.',
    detailZh: '兼容所有 AgentSkills 工具',
    detailEn: 'Works with every AgentSkills tool',
  },
];

const specimens = [
  {
    slug: 'colleague.skill',
    zh: '离职的技术大牛、带过你的老板、共事三年的前辈。',
    en: 'The brilliant teammate who left before you learned everything from them.',
  },
  {
    slug: 'ex-skill',
    zh: '走散的导师、那个你后悔没多请教的人。',
    en: 'The mentor who moved on, the one you regret not asking more.',
  },
  {
    slug: 'author.skill',
    zh: '反复重读的书、读不完的论文、某个领域的圣经。',
    en: 'The book you keep re-reading, the paper you never finish.',
  },
  {
    slug: 'expert.skill',
    zh: '请不起的顾问、约不到的专家、细分领域的神。',
    en: 'The consultant you cannot afford, the expert you cannot reach.',
  },
];
---

<section id="how-it-works" class="scroll-mt-20 border-t border-line py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal max-w-2xl">
      <p class="section-label">
        <span class="lang-zh">如何工作 · How it works</span>
        <span class="lang-en">How it works · 如何工作</span>
      </p>
      <h2 class="mt-4 font-display text-3xl font-semibold leading-[1.2] tracking-tight text-ink md:text-[2.6rem]">
        <span class="lang-zh">三步搞定，不需要 PhD</span>
        <span class="lang-en">Three steps. No PhD required.</span>
      </h2>
      <p class="mt-5 text-base leading-relaxed text-ink-muted">
        <span class="lang-zh">技术上是 RAG 加结构化 Prompt；体验上是那个人还在。</span>
        <span class="lang-en">Under the hood: RAG plus structured prompts. In practice: they never left.</span>
      </p>
    </div>

    <ol class="reveal mt-14 border-y border-line">
      {
        steps.map((step, index) => (
          <li class="grid gap-4 border-b border-line py-8 last:border-b-0 md:grid-cols-[4rem_minmax(0,1fr)_16rem] md:gap-8 md:py-10">
            <span class="font-mono text-sm text-accent-soft">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-display text-2xl font-semibold tracking-tight text-ink">
                <span class="lang-zh">{step.titleZh}</span>
                <span class="lang-en">{step.titleEn}</span>
              </h3>
              <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink-muted">
                <span class="lang-zh">{step.bodyZh}</span>
                <span class="lang-en">{step.bodyEn}</span>
              </p>
            </div>
            <p class="font-mono text-[11px] uppercase leading-relaxed tracking-[0.14em] text-ink-muted md:text-right">
              <span class="lang-zh">{step.detailZh}</span>
              <span class="lang-en">{step.detailEn}</span>
            </p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-16">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-muted">
        <span class="lang-zh">能蒸馏的，不只是一种人</span>
        <span class="lang-en">More than colleagues</span>
      </p>
      <ul class="mt-6 grid gap-8 border-t border-line pt-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          specimens.map((item, index) => (
            <li>
              <p class="font-mono text-[11px] tracking-[0.14em] text-ink-muted">U·{String(index + 1).padStart(2, '0')}</p>
              <p class="mt-2 font-mono text-sm text-accent-soft">{item.slug}</p>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-muted">
                <span class="lang-zh">{item.zh}</span>
                <span class="lang-en">{item.en}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
