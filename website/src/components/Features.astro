---
/**
 * "Why dot-skill" — editorial four-up instead of gradient cards.
 *
 * One claim per card plus one line of evidence, laid out on a hairline grid
 * (1px `bg-line` gaps between paper cells) with Fraunces headings and mono
 * numerals. No emoji, no gradients, no raw Tailwind palette classes.
 *
 * Every number on this page is read from repository data at build time:
 * the catalog size from `src/lib/skills.ts` and the star aggregates from
 * `src/data/github-stars.json` (refreshed by `npm run fetch-stars`).
 */
import { BRAND } from '../data/brand';
import starsData from '../data/github-stars.json';
import { getAllSkills } from '../lib/skills';

const STAR_MAP = starsData as Record<string, { stars: number }>;
const trackedRepos = Object.keys(STAR_MAP).length;
const trackedStars = Object.values(STAR_MAP).reduce((sum, entry) => sum + (entry.stars ?? 0), 0);
const skillCount = (await getAllSkills()).length;

const stats = [
  { value: String(skillCount), zh: '个 Skill 已上架', en: 'skills published' },
  { value: String(trackedRepos), zh: '个社区仓库在跟踪', en: 'community repos tracked' },
  { value: trackedStars.toLocaleString('en-US'), zh: '跟踪仓库累计 Stars', en: 'stars across tracked repos' },
];

interface Feature {
  title: { zh: string; en: string };
  body: { zh: string; en: string };
  evidence: { zh: string; en: string; href?: string };
}

const features: Feature[] = [
  {
    title: { zh: '蒸馏，不是复制', en: 'Distillation, not karaoke' },
    body: {
      zh: '不是把聊天记录喂给模型、让它背台词。提炼的是决策逻辑、工作方式和表达习惯——所以它复现的是那个人的判断。',
      en: 'We do not feed chat logs to a model and hope it memorises the vibes. We extract decision logic, work style and phrasing, so the Skill reproduces how they judged things.',
    },
    evidence: { zh: 'SKILL.md · Work Skill + 5 层 Persona', en: 'SKILL.md · Work Skill + 5-layer Persona' },
  },
  {
    title: { zh: '原材料随便扔', en: 'Garbage in, gold out' },
    body: {
      zh: '飞书、钉钉、Slack、邮件、GitHub PR、截图、PDF——能导出的都塞进来。一段群聊也能起步，边角料也算数。',
      en: 'Feishu, DingTalk, Slack, email threads, GitHub PRs, screenshots, PDFs — throw in whatever you can export. A single group chat is a start; scraps count.',
    },
    evidence: { zh: 'Feishu · DingTalk · Slack · .eml · PR · 截图', en: 'Feishu · DingTalk · Slack · .eml · PR · screenshots' },
  },
  {
    title: { zh: '自进化，自纠正', en: 'It learns. You win.' },
    body: {
      zh: '答错了就直接说「他不会这么做」。Skill 当场记住并写回文件，下一次自动按修正后的方式回答。',
      en: 'When it is off, just say “that is not how they would do it.” The Skill records the correction into its file and answers that way next time.',
    },
    evidence: { zh: 'Self-evolving · Self-correcting · 版本管理', en: 'Self-evolving · Self-correcting · versioned' },
  },
  {
    title: { zh: '开放标准，不锁厂商', en: 'Open standard, no lock-in' },
    body: {
      zh: 'AgentSkills 是开放标准：一份 SKILL.md，任何能读它的 Agent 都能加载。Skill 是你的，平台随你换。',
      en: 'AgentSkills is an open standard: one SKILL.md that any agent able to read it can load. The Skill stays yours and the platform is swappable.',
    },
    evidence: { zh: 'AgentSkills 规范', en: 'AgentSkills spec', href: BRAND.agentskillsUrl },
  },
];
---

<section id="features" class="scroll-mt-20 border-t border-line py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
      <div class="reveal">
        <p class="section-label">
          <span class="lang-zh">为什么 · Features</span>
          <span class="lang-en">Why · Features</span>
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold leading-[1.2] tracking-tight text-ink md:text-[2.6rem]">
          <span class="lang-zh">不只是 Prompt，<br />是一份会思考的 SKILL.md</span>
          <span class="lang-en">Not just a prompt.<br />A SKILL.md that reasons.</span>
        </h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-muted">
          <span class="lang-zh">那些你再也问不到的人——其实还没走远。</span>
          <span class="lang-en">The people you cannot ask anymore? They have not really left.</span>
        </p>
      </div>

      <ul class="reveal grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-3 md:text-right">
        {
          stats.map((stat) => (
            <li>
              <p class="font-display text-2xl font-semibold tracking-tight text-ink md:text-3xl">{stat.value}</p>
              <p class="mt-1 font-mono text-[11px] uppercase leading-relaxed tracking-[0.14em] text-ink-muted">
                <span class="lang-zh">{stat.zh}</span>
                <span class="lang-en">{stat.en}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="stagger-children mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-card border border-line bg-line md:grid-cols-2"
    >
      {
        features.map((feature, index) => (
          <article class="flex flex-col gap-4 bg-paper p-7 md:p-9">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-xs text-accent-soft">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="font-display text-xl font-semibold tracking-tight text-ink">
                <span class="lang-zh">{feature.title.zh}</span>
                <span class="lang-en">{feature.title.en}</span>
              </h3>
            </div>
            <p class="text-[15px] leading-relaxed text-ink-muted">
              <span class="lang-zh">{feature.body.zh}</span>
              <span class="lang-en">{feature.body.en}</span>
            </p>
            <p class="mt-auto border-t border-line pt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-muted">
              {feature.evidence.href ? (
                <a href={feature.evidence.href} target="_blank" rel="noopener noreferrer" class="text-accent-soft hover:text-accent-deep">
                  <span class="lang-zh">{feature.evidence.zh} ↗</span>
                  <span class="lang-en">{feature.evidence.en} ↗</span>
                </a>
              ) : (
                <>
                  <span class="lang-zh">{feature.evidence.zh}</span>
                  <span class="lang-en">{feature.evidence.en}</span>
                </>
              )}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
