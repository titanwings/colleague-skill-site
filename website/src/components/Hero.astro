---
/**
 * Hero — editorial masthead.
 *
 * Structure: kicker (`section-label`) → Fraunces headline (one line per
 * language) → two sentences of copy → two CTAs → a hairline fact bar.
 *
 * Every number is read at build time from `src/data/brand.ts` and
 * `src/data/github-stars.json` (plus the live Skill count and the host count
 * from the support matrix) — nothing is typed in by hand, so the masthead
 * cannot drift from the catalog.
 */
import { BRAND } from '../data/brand';
import { AGENTS } from '../data/agents';
import { getAllSkills } from '../lib/skills';
import starsData from '../data/github-stars.json';

const base = import.meta.env.BASE_URL;

/**
 * Star count comes from the snapshot written by
 * `scripts/fetch-github-stars.mjs`. The snapshot still files the product under
 * its former repo name, so try the canonical key first, the legacy one second,
 * and only then fall back to `BRAND.starsFallback`.
 */
const stars = starsData as Record<string, { stars: number; synced_at: string }>;
const legacyRepo = BRAND.repo.replace(/distilly$/, 'colleague-skill');
const starEntry = stars[BRAND.repo] ?? stars[legacyRepo];
const starCount = starEntry?.stars ?? BRAND.starsFallback;
const starLabel = new Intl.NumberFormat('en-US').format(starCount);

const skillCount = (await getAllSkills()).length;
const hostCount = AGENTS.length;

/**
 * Split the tagline so the trailing clause can carry the single accent.
 * If the marker ever disappears from `brand.ts` the headline degrades to plain
 * ink text instead of breaking.
 */
function splitAccent(text: string, marker: string): { lead: string; accent: string } {
  const at = text.indexOf(marker);
  if (at === -1) return { lead: text, accent: '' };
  return { lead: text.slice(0, at), accent: text.slice(at) };
}

const zhTagline = splitAccent(BRAND.tagline.zh, '.skill');
const enTagline = splitAccent(BRAND.tagline.en, 'Skills');

const facts = [
  {
    value: starLabel,
    zh: 'GitHub 星标',
    en: 'GitHub stars',
  },
  {
    value: String(skillCount),
    zh: '社区 Skill',
    en: 'community Skills',
  },
  {
    value: String(hostCount),
    zh: '可安装的宿主',
    en: 'coding agents supported',
  },
];
---

<section class="border-b border-line">
  <div class="mx-auto max-w-6xl px-4 pb-14 pt-28 sm:px-6 sm:pt-32 lg:px-8 lg:pb-20 lg:pt-40">
    <!-- Kicker: the specification line, not a pill badge. -->
    <p class="section-label">
      <span class="lang-zh">{BRAND.name} · Agent Skill · 开放标准</span>
      <span class="lang-en">{BRAND.name} · Agent Skill · Open Standard</span>
    </p>

    <h1
      class="mt-6 max-w-5xl font-display text-4xl font-semibold leading-[1.06] tracking-tight text-ink sm:text-5xl lg:text-6xl"
    >
      <span class="lang-zh">{zhTagline.lead}<span class="italic text-accent-soft">{zhTagline.accent}</span></span>
      <span class="lang-en">{enTagline.lead}<span class="italic text-accent-soft">{enTagline.accent}</span></span>
    </h1>

    <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-soft sm:text-xl">
      <span class="lang-zh">{BRAND.shortDescription.zh}</span>
      <span class="lang-en">{BRAND.shortDescription.en}</span>
    </p>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-muted">
      <span class="lang-zh">{BRAND.description.zh}</span>
      <span class="lang-en">{BRAND.description.en}</span>
    </p>

    <!-- CTAs: ink-filled primary (paper text, ~15:1 in both themes) + outline
         secondary. No accent-filled button, so nothing sits on the accent. -->
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a
        href="#quickstart"
        class="inline-flex items-center gap-2 rounded-lg bg-ink px-5 py-3 font-medium text-paper transition-colors hover:bg-ink-soft"
      >
        <span class="lang-zh">三步安装</span>
        <span class="lang-en">Install in three steps</span>
        <span aria-hidden="true">→</span>
      </a>
      <a
        href={`${base}/gallery/`}
        class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-3 font-medium text-ink-soft transition-colors hover:border-accent/50 hover:text-accent-soft"
      >
        <span class="lang-zh">浏览 Skill Gallery</span>
        <span class="lang-en">Browse the Skill Gallery</span>
      </a>
      <a
        href={BRAND.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 font-grotesk text-sm text-ink-muted underline decoration-line underline-offset-4 transition-colors hover:text-accent-soft"
      >
        {BRAND.repo} ↗
      </a>
    </div>

    <!-- Fact bar: hairline grid, numbers first. -->
    <dl class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-card border border-line bg-line lg:grid-cols-4">
      {facts.map((fact) => (
        <div class="bg-paper px-5 py-6 sm:px-6">
          <dt class="font-display text-xl font-semibold text-ink sm:text-2xl lg:text-3xl">{fact.value}</dt>
          <dd class="mt-2 font-grotesk text-[11px] uppercase tracking-[0.16em] text-ink-muted">
            <span class="lang-zh">{fact.zh}</span>
            <span class="lang-en">{fact.en}</span>
          </dd>
        </div>
      ))}
      <div class="bg-paper px-5 py-6 sm:px-6">
        <dt class="font-display text-xl font-semibold sm:text-2xl lg:text-3xl">
          <a
            href={BRAND.agentskillsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink transition-colors hover:text-accent-soft"
          >
            AgentSkills ↗
          </a>
        </dt>
        <dd class="mt-2 font-grotesk text-[11px] uppercase tracking-[0.16em] text-ink-muted">
          <span class="lang-zh">开放标准</span>
          <span class="lang-en">Open standard</span>
        </dd>
      </div>
    </dl>

    <p class="mt-4 font-mono text-xs text-ink-muted">
      <span class="lang-zh">
        星标数读自仓库里的 GitHub 快照（scripts/fetch-github-stars.mjs），不是实时数据；Skill 数与宿主数由构建时的目录和 agents.ts 得出。
      </span>
      <span class="lang-en">
        Star count is read from the checked-in GitHub snapshot (scripts/fetch-github-stars.mjs), not a live
        API call; Skill and host counts are derived at build time.
      </span>
    </p>
  </div>
</section>

<style>
  /* Scoped twin of the site-wide language switch: `html[data-lang]` flips the
     pair. It lives here rather than in global.css because that file belongs to
     the design-system PR — see the PR-02 evidence notes. */
  :global(html[data-lang='en']) .lang-zh {
    display: none !important;
  }
  :global(html:not([data-lang='en'])) .lang-en {
    display: none !important;
  }
</style>
